{
  "name": "harvester",
  "version": "1.0.0",
  "private": true,
  "description": "Harvester — bot Discord de jeu de ferme (économie, progression, coopératives, événements saisonniers)",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "start": "node dist/index.js",
    "start:sharded": "node dist/shard.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "commands:deploy": "tsx src/scripts/deploy-commands.ts",
    "commands:deploy:prod": "node dist/scripts/deploy-commands.js",
    "commands:clear": "tsx src/scripts/deploy-commands.ts --clear",
    "commands:clear:prod": "node dist/scripts/deploy-commands.js --clear",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "db:studio": "drizzle-kit studio",
    "balance:report": "tsx src/scripts/balance-report.ts",
    "render:preview": "tsx src/scripts/render-preview.ts",
    "render:preview:en": "PREVIEW_LOCALE=en tsx src/scripts/render-preview.ts",
    "render:matrix": "tsx src/scripts/render-matrix.ts",
    "brand": "tsx src/scripts/generate-brand.ts",
    "build:assets": "node -e \"const fs=require('fs');fs.cpSync('src/config/gameplay','dist/config/gameplay',{recursive:true,filter:(s)=>!s.endsWith('.ts')});fs.cpSync('src/i18n/locales','dist/i18n/locales',{recursive:true});console.log('assets copiés dans dist/')\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "bullmq": "^6.3.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "undici": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  }
}
